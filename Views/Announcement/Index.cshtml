@model IEnumerable<StudentOrganizationSystem.Models.Announcement>

@{
    ViewData["Title"] = "Announcements";
    var isStaff = (bool)(ViewBag.IsStaff ?? false);
    var isAdmin = (bool)(ViewBag.IsAdmin ?? false);
    var isMember = User.IsInRole(AppRoles.Member);
}

<div class="page-container">

    <div class="page-header">
        <div class="page-header-text">
            <h1>Announcements</h1>
            <p>Organization news and updates</p>
        </div>
        @if (isStaff)
        {
            <a asp-action="Create" class="btn btn-primary">+ Post Announcement</a>
        }
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    <div class="filter-card">
        <form asp-action="Index" method="get" class="filter-form">
            <div class="filter-group">
                <label>Search</label>
                <input type="text" name="search" value="@ViewBag.Search"
                       placeholder="Search title or body..." />
            </div>
            @if (isStaff)
            {
                <div class="filter-group">
                    <label>Audience</label>
                    <select name="audience">
                        <option value="">All</option>
                        @foreach (var opt in AnnouncementAudience.All_Values)
                        {
                            if ((string?)ViewBag.Audience == opt)
                            {
                                <option value="@opt" selected>@opt</option>
                            }
                            else
                            {
                                <option value="@opt">@opt</option>
                            }
                        }
                    </select>
                </div>
            }
            <div class="filter-actions">
                <button type="submit" class="btn btn-secondary">Search</button>
                <a asp-action="Index" class="btn btn-light">Clear</a>
            </div>
        </form>
    </div>

    <div class="table-card">
        <div class="table-card-header">
            <h2>Announcement List</h2>
            <span class="record-count">@Model.Count() record(s)</span>
        </div>

        @if (!Model.Any())
        {
            <div class="empty-state"><p>No announcements found.</p></div>
        }
        else
        {
            <div class="table-responsive">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Title</th>
                            @if (isStaff)
                            {
                                <th>Audience</th>
                            }
                            <th>Posted</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var a in Model)
                        {
                            <tr>
                                <td>
                                    @if (a.IsPinned)
                                    {
                                        <span title="Pinned" aria-label="Pinned">📌 </span>
                                    }
                                    <strong>@a.Title</strong>
                                </td>
                                @if (isStaff)
                                {
                                    <td>
                                        <span class="badge @(a.Audience == AnnouncementAudience.All ? "badge-active" : a.Audience == AnnouncementAudience.Members ? "badge-member" : "badge-admin")">
                                            @a.Audience
                                        </span>
                                    </td>
                                }
                                <td>@a.CreatedAt.ToString("MMM dd, yyyy")</td>
                                <td>
                                    <div class="action-group">
                                        <a asp-action="Details" asp-route-id="@a.AnnouncementID"
                                           class="btn btn-sm btn-info">View</a>
                                        @if (isStaff)
                                        {
                                            <a asp-action="Edit" asp-route-id="@a.AnnouncementID"
                                               class="btn btn-sm btn-warning">Edit</a>
                                            @if (a.IsActive)
                                            {
                                                <form asp-action="Deactivate" asp-route-id="@a.AnnouncementID"
                                                      method="post" class="form-inline"
                                                      data-confirm="Deactivate this announcement?">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-sm btn-danger">Deactivate</button>
                                                </form>
                                            }
                                            else
                                            {
                                                <form asp-action="Activate" asp-route-id="@a.AnnouncementID"
                                                      method="post" class="form-inline">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-sm btn-success">Activate</button>
                                                </form>
                                            }
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        <partial name="_Pager" model="ViewBag.Pager" />
    </div>

</div>
