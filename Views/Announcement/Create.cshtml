@model StudentOrganizationSystem.Models.Announcement

@{
    ViewData["Title"] = "Post Announcement";
}

<div class="form-container">

    <div class="page-header form-head">
        <div class="page-header-text">
            <h1>Post Announcement</h1>
            <p>Create a new announcement for the organization</p>
        </div>
        <a asp-action="Index" class="btn btn-light">← Back</a>
    </div>

    <div class="form-card">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

            <div class="form-group">
                <label asp-for="Title">Title</label>
                <input asp-for="Title" class="form-control" placeholder="Announcement title" />
                <span asp-validation-for="Title" class="validation-message"></span>
            </div>

            <div class="form-group">
                <label asp-for="Body">Message</label>
                <textarea asp-for="Body" class="form-control" rows="6"
                          placeholder="Write the announcement here..."></textarea>
                <span asp-validation-for="Body" class="validation-message"></span>
            </div>

            <div class="form-group">
                <label asp-for="Audience">Audience</label>
                <select asp-for="Audience" class="form-control">
                    @foreach (var opt in AnnouncementAudience.All_Values)
                    {
                        <option value="@opt">@opt</option>
                    }
                </select>
                <span asp-validation-for="Audience" class="validation-message"></span>
            </div>

            <div class="form-group">
                <label class="checkbox-label">
                    <input asp-for="IsPinned" type="checkbox" />
                    Pin this announcement (shows at the top)
                </label>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn btn-primary">Post Announcement</button>
                <a asp-action="Index" class="btn btn-light">Cancel</a>
            </div>
        </form>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
