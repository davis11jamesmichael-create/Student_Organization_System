@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty;
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "Index";

    var isAuthenticated = User.Identity?.IsAuthenticated == true;

    var userName = User.Identity?.Name ?? "User";
    var userInitial = string.IsNullOrWhiteSpace(userName)
        ? "U"
        : userName.Trim().Substring(0, 1).ToUpperInvariant();

    // Carried in the cookie (see UserClaims), so the top bar needs no DB lookup.
    var userAvatar = User.FindFirst(AppClaims.AvatarPath)?.Value;

    // Role split (AUDIT.md P0.6): Admins additionally see the "Administration"
    // group. A "Member" login gets its own reduced navigation, because it cannot
    // open any of the management pages (they are all Admin-or-Officer).
    var isAdmin = User.IsInRole(AppRoles.Admin);
    var isMember = User.IsInRole(AppRoles.Member);

    var pageTitle = ViewData["Title"]?.ToString() ?? "Dashboard";

    // Highlight on BOTH the controller and the action, so the Portal's three
    // entries (My Records / My Attendance / My Participation) each light up on
    // their own page instead of every one of them sharing "My Records".
    Func<string, string, bool> isActive = (controller, action) =>
        string.Equals(currentController, controller, StringComparison.OrdinalIgnoreCase) &&
        string.Equals(currentAction, action, StringComparison.OrdinalIgnoreCase);

    Func<string, string, string> navClass = (controller, action) =>
        isActive(controller, action) ? "nav-item active" : "nav-item";

    Func<string, string, string?> navAria = (controller, action) =>
        isActive(controller, action) ? "page" : null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Student Organization System</title>
    <link rel="stylesheet" href="~/css/base.css" />
    <link rel="stylesheet" href="~/css/sidebar.css" />
    <link rel="stylesheet" href="~/css/navbar.css" />
    <link rel="stylesheet" href="~/css/components.css" />
    <link rel="stylesheet" href="~/css/forms.css" />
    <link rel="stylesheet" href="~/css/tables.css" />
    <link rel="stylesheet" href="~/css/dashboard.css" />
    <link rel="stylesheet" href="~/css/attendance.css" />
    <link rel="stylesheet" href="~/css/participation.css" />
    <link rel="stylesheet" href="~/css/print.css" />
    <link rel="stylesheet" href="~/css/responsive.css" />
</head>
<body>

@* AUDIT.md P3: a keyboard user can jump straight past the navigation. *@
<a class="skip-link" href="#main-content">Skip to main content</a>

@if (isAuthenticated)
{
    <div class="app-shell">

        <aside class="sidebar" id="appSidebar" aria-label="Main navigation">

            <a class="sidebar-brand" asp-controller="Home" asp-action="Index">
                <span class="sidebar-brand-icon">🎓</span>
                <span class="sidebar-brand-text">
                    <span class="sidebar-brand-title">Student Org</span>
                    <span class="sidebar-brand-sub">Management System</span>
                </span>
            </a>

            <nav class="sidebar-nav">

                @if (isMember)
                {
                    @* A member can only reach the Portal, so the menu shows only
                       the pages they can actually open. *@
                    <div class="nav-section">
                        <span class="nav-section-title">My Records</span>
                        <a class="@navClass("Portal", "Index")" aria-current="@navAria("Portal", "Index")"
                           asp-controller="Portal" asp-action="Index">
                            <span class="nav-icon">🧾</span>
                            <span class="nav-text">My Records</span>
                        </a>
                        <a class="@navClass("Portal", "History")" aria-current="@navAria("Portal", "History")"
                           asp-controller="Portal" asp-action="History">
                            <span class="nav-icon">📋</span>
                            <span class="nav-text">My Attendance &amp; Participation</span>
                        </a>
                    </div>
                }
                else
                {
                    <div class="nav-section">
                        <span class="nav-section-title">Overview</span>
                        <a class="@navClass("Home", "Index")" aria-current="@navAria("Home", "Index")"
                           asp-controller="Home" asp-action="Index">
                            <span class="nav-icon">📊</span>
                            <span class="nav-text">Dashboard</span>
                        </a>
                    </div>

                    <div class="nav-section">
                        <span class="nav-section-title">Management</span>
                        <a class="@navClass("Member", "Index")" aria-current="@navAria("Member", "Index")"
                           asp-controller="Member" asp-action="Index">
                            <span class="nav-icon">👥</span>
                            <span class="nav-text">Members</span>
                        </a>
                        <a class="@navClass("Activity", "Index")" aria-current="@navAria("Activity", "Index")"
                           asp-controller="Activity" asp-action="Index">
                            <span class="nav-icon">📅</span>
                            <span class="nav-text">Activities</span>
                        </a>
                        <a class="@navClass("Membership", "Index")" aria-current="@navAria("Membership", "Index")"
                           asp-controller="Membership" asp-action="Index">
                            <span class="nav-icon">🪪</span>
                            <span class="nav-text">Membership</span>
                        </a>
                    </div>

                    @if (isAdmin)
                    {
                        <div class="nav-section">
                            <span class="nav-section-title">Administration</span>
                            <a class="@navClass("User", "Index")" aria-current="@navAria("User", "Index")"
                               asp-controller="User" asp-action="Index">
                                <span class="nav-icon">🔑</span>
                                <span class="nav-text">Users &amp; Roles</span>
                            </a>
                        </div>
                    }

                    <div class="nav-section">
                        <span class="nav-section-title">Tracking</span>
                        <a class="@navClass("Attendance", "Index")" aria-current="@navAria("Attendance", "Index")"
                           asp-controller="Attendance" asp-action="Index">
                            <span class="nav-icon">📋</span>
                            <span class="nav-text">Attendance</span>
                        </a>
                        <a class="@navClass("Participation", "Index")" aria-current="@navAria("Participation", "Index")"
                           asp-controller="Participation" asp-action="Index">
                            <span class="nav-icon">🏅</span>
                            <span class="nav-text">Participation</span>
                        </a>
                    </div>

                    <div class="nav-section">
                        <span class="nav-section-title">Insights</span>
                        <a class="@navClass("Reports", "Index")" aria-current="@navAria("Reports", "Index")"
                           asp-controller="Reports" asp-action="Index">
                            <span class="nav-icon">📈</span>
                            <span class="nav-text">Reports</span>
                        </a>
                    </div>
                }

            </nav>

            <div class="sidebar-footer">
                <a class="sidebar-signout" asp-controller="Account" asp-action="ChangePassword">
                    <span aria-hidden="true">🔒</span>
                    Change password
                </a>
                <form asp-controller="Account" asp-action="Logout" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="sidebar-signout">
                        <span aria-hidden="true">⏻</span>
                        Logout
                    </button>
                </form>
                <p class="sidebar-note">&copy; @DateTime.Now.Year Student Org System</p>
            </div>

        </aside>

        <div class="sidebar-backdrop" id="sidebarBackdrop" aria-hidden="true"></div>

        <div class="app-main">

            <header class="topbar">

                <button type="button" class="icon-btn topbar-toggle"
                        id="sidebarToggle"
                        aria-label="Toggle navigation menu"
                        aria-controls="appSidebar"
                        aria-expanded="false">
                    <span></span>
                    <span></span>
                    <span></span>
                </button>

                <div class="topbar-title">
                    <h1>@pageTitle</h1>
                    <span>@DateTime.Now.ToString("dddd, MMMM d, yyyy")</span>
                </div>

                <form class="topbar-search" asp-controller="Search" asp-action="Index"
                      method="get" role="search">
                    <input type="search" name="q" value="@Context.Request.Query["q"]"
                           placeholder="Search members or activities" aria-label="Search" />
                </form>

                <div class="topbar-actions">
                    <a class="topbar-user" asp-controller="Profile" asp-action="Index"
                       title="My profile">
                        @if (!string.IsNullOrWhiteSpace(userAvatar))
                        {
                            <img class="avatar avatar-sm avatar-image" src="@userAvatar"
                                 alt="Profile picture of @userName" />
                        }
                        else
                        {
                            <span class="avatar avatar-sm">@userInitial</span>
                        }
                        <span class="topbar-user-text">
                            <span class="topbar-user-name">
                                @userName
                                @if (isMember)
                                {
                                    <span class="badge-role badge-member">Member</span>
                                }
                                else if (isAdmin)
                                {
                                    <span class="badge-role badge-admin">Admin</span>
                                }
                                else
                                {
                                    <span class="badge-role badge-officer">Officer</span>
                                }
                            </span>
                        </span>
                    </a>
                </div>

            </header>

            <main class="app-content" id="main-content">
                @RenderBody()
            </main>

            <footer class="footer">
                <p>&copy; @DateTime.Now.Year &nbsp;Student Organization Management System</p>
            </footer>

        </div>

    </div>
}
else
{
    <main class="main-content" id="main-content">
        @RenderBody()
    </main>

    <footer class="footer">
        <p>&copy; @DateTime.Now.Year &nbsp;Student Organization Management System</p>
    </footer>
}

<script src="~/js/site.js"></script>
@await RenderSectionAsync("Scripts", required: false)

</body>
</html>
