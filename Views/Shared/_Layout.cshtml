@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty;

    var isAuthenticated = User.Identity?.IsAuthenticated == true;

    var userName = User.Identity?.Name ?? "User";
    var userInitial = string.IsNullOrWhiteSpace(userName)
        ? "U"
        : userName.Trim().Substring(0, 1).ToUpperInvariant();

    var userRole = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value;
    if (string.IsNullOrWhiteSpace(userRole))
    {
        userRole = "User";
    }

    // Role split (AUDIT.md P0.6): Admins additionally see the "Administration"
    // group. A "Member" login gets its own reduced navigation, because it cannot
    // open any of the management pages (they are all Admin-or-Officer).
    var isAdmin = User.IsInRole(AppRoles.Admin);
    var isMember = User.IsInRole(AppRoles.Member);

    var pageTitle = ViewData["Title"]?.ToString() ?? "Dashboard";

    Func<string, bool> isActive = controller =>
        !string.IsNullOrEmpty(currentController) &&
        string.Equals(currentController, controller, StringComparison.OrdinalIgnoreCase);

    Func<string, string> navClass = controller =>
        isActive(controller) ? "nav-item active" : "nav-item";

    Func<string, string?> navAria = controller =>
        isActive(controller) ? "page" : null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Student Organization System</title>
    <link rel="stylesheet" href="~/css/base.css" />
    <link rel="stylesheet" href="~/css/sidebar.css" />
    <link rel="stylesheet" href="~/css/navbar.css" />
    <link rel="stylesheet" href="~/css/components.css" />
    <link rel="stylesheet" href="~/css/forms.css" />
    <link rel="stylesheet" href="~/css/tables.css" />
    <link rel="stylesheet" href="~/css/dashboard.css" />
    <link rel="stylesheet" href="~/css/attendance.css" />
    <link rel="stylesheet" href="~/css/participation.css" />
    <link rel="stylesheet" href="~/css/print.css" />
    <link rel="stylesheet" href="~/css/responsive.css" />
</head>
<body>

@* AUDIT.md P3: a keyboard user can jump straight past the navigation. *@
<a class="skip-link" href="#main-content">Skip to main content</a>

@if (isAuthenticated)
{
    <div class="app-shell">

        <aside class="sidebar" id="appSidebar" aria-label="Main navigation">

            <a class="sidebar-brand" asp-controller="Home" asp-action="Index">
                <span class="sidebar-brand-icon">🎓</span>
                <span class="sidebar-brand-text">
                    <span class="sidebar-brand-title">Student Org</span>
                    <span class="sidebar-brand-sub">Management System</span>
                </span>
            </a>

            <nav class="sidebar-nav">

                @if (isMember)
                {
                    @* A member can only reach the Portal, so the menu shows only
                       the pages they can actually open. *@
                    <div class="nav-section">
                        <span class="nav-section-title">My Records</span>
                        <a class="@navClass("Portal")" aria-current="@navAria("Portal")"
                           asp-controller="Portal" asp-action="Index">
                            <span class="nav-icon">🧾</span>
                            <span class="nav-text">My Records</span>
                        </a>
                        <a class="nav-item" asp-controller="Portal" asp-action="Attendance">
                            <span class="nav-icon">📋</span>
                            <span class="nav-text">My Attendance</span>
                        </a>
                        <a class="nav-item" asp-controller="Portal" asp-action="Participation">
                            <span class="nav-icon">🏅</span>
                            <span class="nav-text">My Participation</span>
                        </a>
                    </div>
                }
                else
                {
                    <div class="nav-section">
                        <span class="nav-section-title">Overview</span>
                        <a class="@navClass("Home")" aria-current="@navAria("Home")"
                           asp-controller="Home" asp-action="Index">
                            <span class="nav-icon">📊</span>
                            <span class="nav-text">Dashboard</span>
                        </a>
                        <a class="@navClass("Search")" aria-current="@navAria("Search")"
                           asp-controller="Search" asp-action="Index">
                            <span class="nav-icon">🔍</span>
                            <span class="nav-text">Search</span>
                        </a>
                    </div>

                <div class="nav-section">
                    <span class="nav-section-title">Management</span>
                    <a class="@navClass("Member")" aria-current="@navAria("Member")"
                       asp-controller="Member" asp-action="Index">
                        <span class="nav-icon">👥</span>
                        <span class="nav-text">Members</span>
                    </a>
                    <a class="@navClass("Activity")" aria-current="@navAria("Activity")"
                       asp-controller="Activity" asp-action="Index">
                        <span class="nav-icon">📅</span>
                        <span class="nav-text">Activities</span>
                    </a>
                    <a class="@navClass("Membership")" aria-current="@navAria("Membership")"
                       asp-controller="Membership" asp-action="Index">
                        <span class="nav-icon">🪪</span>
                        <span class="nav-text">Membership</span>
                    </a>
                </div>

                @if (isAdmin)
                {
                    <div class="nav-section">
                        <span class="nav-section-title">Administration</span>
                        <a class="nav-item" asp-controller="Member" asp-action="Create">
                            <span class="nav-icon">➕</span>
                            <span class="nav-text">Add Member</span>
                        </a>
                        <a class="nav-item" asp-controller="Activity" asp-action="Create">
                            <span class="nav-icon">🗓️</span>
                            <span class="nav-text">Add Activity</span>
                        </a>
                        <a class="@navClass("User")" aria-current="@navAria("User")"
                           asp-controller="User" asp-action="Index">
                            <span class="nav-icon">🔑</span>
                            <span class="nav-text">Users &amp; Roles</span>
                        </a>
                    </div>
                }

                <div class="nav-section">
                    <span class="nav-section-title">Tracking</span>
                    <a class="@navClass("Attendance")" aria-current="@navAria("Attendance")"
                       asp-controller="Attendance" asp-action="Index">
                        <span class="nav-icon">📋</span>
                        <span class="nav-text">Attendance</span>
                    </a>
                    <a class="@navClass("Participation")" aria-current="@navAria("Participation")"
                       asp-controller="Participation" asp-action="Index">
                        <span class="nav-icon">🏅</span>
                        <span class="nav-text">Participation</span>
                    </a>
                </div>

                <div class="nav-section">
                    <span class="nav-section-title">Insights</span>
                    <a class="@navClass("Reports")" aria-current="@navAria("Reports")"
                       asp-controller="Reports" asp-action="Index">
                        <span class="nav-icon">📈</span>
                        <span class="nav-text">Reports</span>
                    </a>
                </div>
                }

            </nav>

            <div class="sidebar-footer">
                <a class="sidebar-signout" asp-controller="Account" asp-action="ChangePassword">
                    <span aria-hidden="true">🔒</span>
                    Change password
                </a>
                <form asp-controller="Account" asp-action="Logout" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="sidebar-signout">
                        <span aria-hidden="true">⏻</span>
                        Sign out
                    </button>
                </form>
                <p class="sidebar-note">&copy; @DateTime.Now.Year Student Org System</p>
            </div>

        </aside>

        <div class="sidebar-backdrop" id="sidebarBackdrop" aria-hidden="true"></div>

        <div class="app-main">

            <header class="topbar">

                <button type="button" class="icon-btn topbar-toggle"
                        id="sidebarToggle"
                        aria-label="Toggle navigation menu"
                        aria-controls="appSidebar"
                        aria-expanded="false">
                    <span></span>
                    <span></span>
                    <span></span>
                </button>

                <div class="topbar-title">
                    <h1>@pageTitle</h1>
                    <span>@DateTime.Now.ToString("dddd, MMMM d, yyyy")</span>
                </div>

                <form class="topbar-search" asp-controller="Search" asp-action="Index"
                      method="get" role="search">
                    <input type="search" name="q" value="@Context.Request.Query["q"]"
                           placeholder="Search members or activities" aria-label="Search" />
                </form>

                <div class="topbar-actions">
                    <div class="topbar-user">
                        <span class="avatar avatar-sm">@userInitial</span>
                        <span class="topbar-user-text">
                            <span class="topbar-user-name">
                                @userName
                                @if (isMember)
                                {
                                    <span class="badge-role badge-member">Member</span>
                                }
                                else if (isAdmin)
                                {
                                    <span class="badge-role badge-admin">Admin</span>
                                }
                                else
                                {
                                    <span class="badge-role badge-officer">Officer</span>
                                }
                            </span>
                            <span class="topbar-user-role">@userRole</span>
                        </span>
                    </div>
                </div>

            </header>

            <main class="app-content" id="main-content">
                @RenderBody()
            </main>

            <footer class="footer">
                <p>&copy; @DateTime.Now.Year &nbsp;Student Organization Management System</p>
            </footer>

        </div>

    </div>
}
else
{
    <main class="main-content" id="main-content">
        @RenderBody()
    </main>

    <footer class="footer">
        <p>&copy; @DateTime.Now.Year &nbsp;Student Organization Management System</p>
    </footer>
}

<script src="~/js/site.js"></script>
@await RenderSectionAsync("Scripts", required: false)

</body>
</html>
