@{
    ViewData["Title"] = "Registration Received";
}

<div class="page-container">

    <div class="error-page">

        <div class="error-page-icon">✅</div>

        <h1>Registration received</h1>

        <p>
            Your account is waiting for approval by an organization adviser.
            You will be able to sign in once it has been approved.
        </p>

        <div class="error-page-actions">
            <a asp-controller="Account" asp-action="Login" class="btn btn-primary">
                Back to sign in
            </a>
        </div>

    </div>

</div>