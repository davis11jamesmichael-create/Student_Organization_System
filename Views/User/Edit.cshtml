@model StudentOrganizationSystem.Models.UserFormViewModel

@{
    ViewData["Title"] = "Edit User";

    var roles = ViewBag.Roles as List<StudentOrganizationSystem.Models.Role>
                ?? new List<StudentOrganizationSystem.Models.Role>();
}

<div class="form-container">

    <div class="page-header form-head">
        <div class="page-header-text">
            <h1>Edit User</h1>
            <p>Change the role, the linked member or the status</p>
        </div>
        <a asp-action="Index" class="btn btn-light">← Back</a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="form-card">
        <form asp-action="Edit" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="UserID" />
            <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

            <div class="form-group">
                <label asp-for="Username">Username</label>
                <input asp-for="Username" class="form-control" />
                <span asp-validation-for="Username" class="validation-message"></span>
            </div>

            <div class="form-group">
                <label asp-for="RoleID">Role</label>
                <select asp-for="RoleID" class="form-control">
                    @foreach (var role in roles)
                    {
                        <option value="@role.RoleID">@role.RoleName</option>
                    }
                </select>
                <span asp-validation-for="RoleID" class="validation-message"></span>
            </div>

            <div class="form-group">
                <label asp-for="MemberID">Linked Member</label>
                <select asp-for="MemberID" class="form-control"
                        asp-items="@(ViewBag.MemberOptions as Microsoft.AspNetCore.Mvc.Rendering.SelectList)">
                    <option value="">— Not linked —</option>
                </select>
                <span class="validation-message validation-hint">
                    Required only for the Member role.
                </span>
                <span asp-validation-for="MemberID" class="validation-message"></span>
            </div>

            <div class="form-group checkbox-row">
                <label class="remember-row">
                    <input asp-for="IsActive" />
                    Account is active
                </label>
            </div>

            <div class="form-group">
                <label asp-for="Password">New Password</label>
                <input asp-for="Password" class="form-control" autocomplete="new-password" />
                <span class="validation-message validation-hint">
                    Leave blank to keep the current password.
                </span>
                <span asp-validation-for="Password" class="validation-message"></span>
            </div>

            <div class="form-group">
                <label asp-for="ConfirmPassword">Confirm New Password</label>
                <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword" class="validation-message"></span>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn btn-primary">Save Changes</button>
                <a asp-action="Index" class="btn btn-light">Cancel</a>
            </div>
        </form>
    </div>

    <div class="form-card card-stacked">
        <h2 class="card-subtitle">Reset Password</h2>
        <form asp-action="ResetPassword" asp-route-id="@Model.UserID" method="post">
            @Html.AntiForgeryToken()
            <div class="form-group">
                <label for="newPassword">Set a new password</label>
                <input type="password" id="newPassword" name="newPassword"
                       class="form-control" autocomplete="new-password" />
            </div>
            <div class="form-actions">
                <button type="submit" class="btn btn-secondary">Reset Password</button>
            </div>
        </form>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}