@model IEnumerable<StudentOrganizationSystem.Models.Participation>

@{
    ViewData["Title"] = "My Participation";

    var member = ViewBag.Member as StudentOrganizationSystem.Models.Member;
}

<div class="page-container">

    <div class="page-header">
        <div class="page-header-text">
            <h1>My Participation</h1>
            <p>@member?.FullName &middot; @member?.StudentID</p>
        </div>
        <a asp-action="Index" class="btn btn-light">← My Records</a>
    </div>

    <div class="table-card">

        <div class="table-card-header">
            <h2>Participation History</h2>
            <span class="record-count">@Model.Count() record(s)</span>
        </div>

        @if (!Model.Any())
        {
            <div class="empty-state">
                <p>No participation has been recorded for you yet.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Activity</th>
                            <th>Date</th>
                            <th>Location</th>
                            <th>Participation Type</th>
                            <th>Recorded</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var record in Model)
                        {
                            <tr>
                                <td><strong>@record.Activity?.ActivityTitle</strong></td>
                                <td>@record.Activity?.ActivityDate.ToString("MMM dd, yyyy")</td>
                                <td>@record.Activity?.Location</td>
                                <td>@record.ParticipationType</td>
                                <td>@record.RecordedAt.ToString("MMM dd, yyyy")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

    </div>

</div>