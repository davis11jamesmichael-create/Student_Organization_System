@model IEnumerable<StudentOrganizationSystem.Models.MemberRecordViewModel>

@{
    ViewData["Title"] = "My Attendance & Participation";

    var member = ViewBag.Member as StudentOrganizationSystem.Models.Member;
}

<div class="page-container">

    <div class="page-header">
        <div class="page-header-text">
            <h1>My Attendance &amp; Participation</h1>
            <p>@member?.FullName &middot; @member?.StudentID</p>
        </div>
        <a asp-action="Index" class="btn btn-light">← My Records</a>
    </div>

    <div class="table-card">

        <div class="table-card-header">
            <h2>Attendance &amp; Participation History</h2>
            <span class="record-count">@Model.Count() record(s)</span>
        </div>

        @if (!Model.Any())
        {
            <div class="empty-state">
                <p>No attendance or participation has been recorded for you yet.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Activity</th>
                            <th>Date</th>
                            <th>Location</th>
                            <th>Participation Type</th>
                            <th>Status</th>
                            <th>Recorded</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var record in Model)
                        {
                            <tr>
                                <td><strong>@record.ActivityTitle</strong></td>
                                <td>@record.ActivityDate.ToString("MMM dd, yyyy")</td>
                                <td>@record.Location</td>
                                <td>
                                    @if (string.IsNullOrWhiteSpace(record.ParticipationType))
                                    { <span class="hint-cell">—</span> }
                                    else
                                    { @record.ParticipationType }
                                </td>
                                <td>
                                    @if (record.AttendanceStatus == "Present")
                                    { <span class="badge badge-present">Present</span> }
                                    else if (record.AttendanceStatus == "Absent")
                                    { <span class="badge badge-absent">Absent</span> }
                                    else
                                    { <span class="hint-cell">Not marked</span> }
                                </td>
                                <td>
                                    @if (record.RecordedAt.HasValue)
                                    { @record.RecordedAt.Value.ToString("MMM dd, yyyy") }
                                    else
                                    { <span class="hint-cell">—</span> }
                                </td>
                                <td>
                                    <a asp-controller="Portal" asp-action="Activities"
                                       asp-route-id="@record.ActivityID"
                                       class="btn btn-sm btn-light">💬 Discuss</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

    </div>

</div>
