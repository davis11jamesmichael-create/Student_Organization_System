@model IEnumerable<StudentOrganizationSystem.Models.Member>

@{
    ViewData["Title"] = "Members";
}

<div class="page-container">

    <div class="page-header">
        <div class="page-header-text">
            <h1>Members</h1>
            <p>Manage organization member records</p>
        </div>
        <a asp-action="Create" class="btn btn-primary">+ Add Member</a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    <div class="filter-card">
        <form asp-action="Index" method="get" class="filter-form">
            <div class="filter-group">
                <label>Search</label>
                <input type="text" name="search" value="@ViewBag.Search"
                       placeholder="Name or Student ID" />
            </div>
            <div class="filter-group">
                <label>Status</label>
                <select name="status">
                    <option value="">All</option>
                    @if (ViewBag.Status == "Active") {
                        <option value="Active" selected>Active</option>
                        <option value="Inactive">Inactive</option>
                    } else if (ViewBag.Status == "Inactive") {
                        <option value="Active">Active</option>
                        <option value="Inactive" selected>Inactive</option>
                    } else {
                        <option value="Active">Active</option>
                        <option value="Inactive">Inactive</option>
                    }
                </select>
            </div>
            <div class="filter-actions">
                <button type="submit" class="btn btn-secondary">Search</button>
                <a asp-action="Index" class="btn btn-light">Clear</a>
            </div>
        </form>
    </div>

    <div class="table-card">
        <div class="table-card-header">
            <h2>Member List</h2>
            <span class="record-count">@Model.Count() record(s)</span>
        </div>
        <div class="table-responsive">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Student ID</th>
                        <th>Full Name</th>
                        <th>Course</th>
                        <th>Year Level</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        foreach (var m in Model)
                        {
                            <tr>
                                <td>@m.StudentID</td>
                                <td><strong>@m.FullName</strong></td>
                                <td>@m.Course</td>
                                <td>@m.YearLevel</td>
                                <td>
                                    @if (m.IsActive)
                                    { <span class="badge badge-active">Active</span> }
                                    else
                                    { <span class="badge badge-inactive">Inactive</span> }
                                </td>
                                <td>
                                    <div class="action-group">
                                        <a asp-action="Details" asp-route-id="@m.MemberID"
                                           class="btn btn-sm btn-info">View</a>
                                        <a asp-action="Edit" asp-route-id="@m.MemberID"
                                           class="btn btn-sm btn-warning">Edit</a>
                                        @if (m.IsActive)
                                        {
                                            <form asp-action="Deactivate" asp-route-id="@m.MemberID" method="post">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-danger">Deactivate</button>
                                            </form>
                                        }
                                        else
                                        {
                                            <form asp-action="Activate" asp-route-id="@m.MemberID" method="post">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-success">Activate</button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr><td colspan="6"><div class="empty-state"><p>No members found.</p></div></td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

</div>
