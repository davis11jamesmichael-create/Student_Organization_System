@model StudentOrganizationSystem.Models.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";

    var userName = User.Identity?.Name ?? "User";
}

<div class="page-container">

    <section class="dashboard-hero">

        <div class="dashboard-hero-text">
            <h1>Good day, @userName 👋</h1>
            <p>
                @DateTime.Now.ToString("dddd, MMMM d, yyyy")
                &nbsp;·&nbsp; Here's what's happening in the organization.
            </p>
        </div>

        <div class="dashboard-hero-actions">
            <a asp-controller="Member" asp-action="Create" class="hero-btn">
                + Add Member
            </a>
            <a asp-controller="Attendance" asp-action="Index"
               class="hero-btn hero-btn-outline">
                Record Attendance
            </a>
        </div>

    </section>

    <div class="stats-grid">

        <div class="stat-card">
            <div class="stat-icon indigo">👥</div>
            <div class="stat-body">
                <div class="stat-label">Total Members</div>
                <div class="stat-number">@Model.TotalMembers</div>
                <div class="stat-sub">@Model.ActiveMembers active</div>
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-icon green">✅</div>
            <div class="stat-body">
                <div class="stat-label">Active Members</div>
                <div class="stat-number">@Model.ActiveMembers</div>
                <div class="stat-sub">of @Model.TotalMembers total</div>
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-icon blue">📅</div>
            <div class="stat-body">
                <div class="stat-label">Total Activities</div>
                <div class="stat-number">@Model.TotalActivities</div>
                <div class="stat-sub">@Model.ActiveActivities active</div>
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-icon amber">🎯</div>
            <div class="stat-body">
                <div class="stat-label">Active Activities</div>
                <div class="stat-number">@Model.ActiveActivities</div>
                <div class="stat-sub">of @Model.TotalActivities total</div>
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-icon indigo">📋</div>
            <div class="stat-body">
                <div class="stat-label">Attendance Records</div>
                <div class="stat-number">@Model.TotalAttendance</div>
                <div class="stat-sub">across all activities</div>
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-icon green">🏅</div>
            <div class="stat-body">
                <div class="stat-label">Participation Records</div>
                <div class="stat-number">@Model.TotalParticipation</div>
                <div class="stat-sub">across all activities</div>
            </div>
        </div>

    </div>

    <div class="section-title">Quick Access</div>

    <div class="quick-grid">

        <a asp-controller="Member" asp-action="Index" class="quick-card">
            <div class="quick-card-icon">👥</div>
            <div class="quick-card-text">
                <h3>Members</h3>
                <p>Manage member records</p>
            </div>
            <span class="quick-card-arrow" aria-hidden="true">→</span>
        </a>

        <a asp-controller="Activity" asp-action="Index" class="quick-card">
            <div class="quick-card-icon">📅</div>
            <div class="quick-card-text">
                <h3>Activities</h3>
                <p>Manage activities and events</p>
            </div>
            <span class="quick-card-arrow" aria-hidden="true">→</span>
        </a>

        <a asp-controller="Attendance" asp-action="Index" class="quick-card">
            <div class="quick-card-icon">📋</div>
            <div class="quick-card-text">
                <h3>Attendance</h3>
                <p>Record and view attendance</p>
            </div>
            <span class="quick-card-arrow" aria-hidden="true">→</span>
        </a>

        <div class="quick-card is-soon">
            <div class="quick-card-icon">🪪</div>
            <div class="quick-card-text">
                <h3>Membership</h3>
                <p>Monitor membership status</p>
            </div>
            <span class="chip-soon">Soon</span>
        </div>

        <div class="quick-card is-soon">
            <div class="quick-card-icon">🏅</div>
            <div class="quick-card-text">
                <h3>Participation</h3>
                <p>Monitor member participation</p>
            </div>
            <span class="chip-soon">Soon</span>
        </div>

        <div class="quick-card is-soon">
            <div class="quick-card-icon">📈</div>
            <div class="quick-card-text">
                <h3>Reports</h3>
                <p>View records and reports</p>
            </div>
            <span class="chip-soon">Soon</span>
        </div>

    </div>

</div>
