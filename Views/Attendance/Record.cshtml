@model IEnumerable<StudentOrganizationSystem.Models.Member>

@{
    ViewData["Title"] = "Record Attendance";
    var activity = ViewBag.Activity as StudentOrganizationSystem.Models.Activity;
    var existing = ViewBag.ExistingAttendance as Dictionary<int, string>
                   ?? new Dictionary<int, string>();

    var members = Model.ToList();

    // P1.1: a member counts as marked only when a valid status was already
    // saved. Anything unmarked starts with no radio selected, so a status is
    // never invented just by opening the form and pressing Save.
    var marked = members.Count(m =>
        existing.ContainsKey(m.MemberID)
        && AttendanceStatus.IsValid(existing[m.MemberID]));

    var unmarked = members.Count - marked;
}

<div class="page-container">

    <div class="page-header">
        <div class="page-header-text">
            <h1>Record Attendance</h1>
            <p>
                <strong>@activity?.ActivityTitle</strong>
                &nbsp;·&nbsp; @activity?.ActivityDate.ToString("MMMM dd, yyyy")
                &nbsp;·&nbsp; @activity?.Location
            </p>
        </div>
        <a asp-action="Index" class="btn btn-light">← Back</a>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    @if (!members.Any())
    {
        <div class="alert alert-info">
            No active members found. Please add members first.
        </div>
    }
    else
    {
        <form asp-action="Record" asp-route-id="@activity?.ActivityID"
              method="post" id="attendance-form">
            @Html.AntiForgeryToken()

            <div class="table-card card-spaced">
                <div class="table-card-header">
                    <h2>Members</h2>
                    <span class="record-count">@members.Count active member(s)</span>
                </div>

                <div class="attendance-toolbar">
                    <span id="unmarked-count"
                          class="attendance-counter @(unmarked == 0 ? "is-clear" : "")"
                          data-unmarked="@unmarked">
                        @(unmarked == 0
                            ? "All members marked"
                            : unmarked + " member(s) not yet marked")
                    </span>
                    <div class="attendance-toolbar-actions">
                        <button type="button" class="btn btn-sm btn-light"
                                data-mark-all="Present">
                            Mark all present
                        </button>
                        <button type="button" class="btn btn-sm btn-light"
                                data-mark-all="Absent">
                            Mark all absent
                        </button>
                    </div>
                </div>

                @foreach (var member in members)
                {
                    var hasSaved = existing.ContainsKey(member.MemberID)
                                   && AttendanceStatus.IsValid(existing[member.MemberID]);
                    var status = hasSaved ? existing[member.MemberID] : null;

                    <div class="attendance-row" data-member-row>
                        <div class="attendance-member">
                            <div class="attendance-member-name">@member.FullName</div>
                            <div class="attendance-member-meta">
                                @member.StudentID · @member.Course · @member.YearLevel
                            </div>
                        </div>
                        <div class="radio-group">
                            <label class="radio-option present @(status == "Present" ? "selected" : "")">
                                <input type="radio"
                                       name="attendance[@member.MemberID]"
                                       value="Present"
                                       @(status == "Present" ? "checked" : "") />
                                Present
                            </label>
                            <label class="radio-option absent @(status == "Absent" ? "selected" : "")">
                                <input type="radio"
                                       name="attendance[@member.MemberID]"
                                       value="Absent"
                                       @(status == "Absent" ? "checked" : "") />
                                Absent
                            </label>
                        </div>
                    </div>
                }
            </div>

            <div class="btn-row">
                <button type="submit" class="btn btn-primary">Save Attendance</button>
                <a asp-action="Index" class="btn btn-light">Cancel</a>
            </div>

        </form>
    }

</div>



