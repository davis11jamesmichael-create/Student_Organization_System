@model IEnumerable<StudentOrganizationSystem.Models.Activity>

@{
    ViewData["Title"] = "Activities";

    // Admin-only controls are hidden from Officers; the actions themselves are
    // also guarded server-side (ActivityController Create/Edit/Activate/Deactivate).
    var isAdmin = User.IsInRole(AppRoles.Admin);
}

<div class="page-container">

    <div class="page-header">
        <div class="page-header-text">
            <h1>Activities</h1>
            <p>Manage organization activities and events</p>
        </div>
        @if (isAdmin)
        {
            <a asp-action="Create" class="btn btn-primary">+ Add Activity</a>
        }
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    @if (!isAdmin)
    {
        <div class="admin-note">
            <span aria-hidden="true">🔒</span>
            Signed in as Officer — admin-only actions (add, edit, cancel / activate) are hidden.
        </div>
    }

    <div class="filter-card">
        <form asp-action="Index" method="get" class="filter-form">
            <div class="filter-group">
                <label>Title</label>
                <input type="text" name="search" value="@ViewBag.Search"
                       placeholder="Search title..." />
            </div>
            <div class="filter-group">
                <label>Date</label>
                <input type="date" name="activityDate" value="@ViewBag.ActivityDate" />
            </div>
            <div class="filter-group">
                <label>Status</label>
                <select name="status">
                    <option value="">All</option>
                    @if (ViewBag.Status == "Active") {
                        <option value="Active" selected>Active</option>
                        <option value="Inactive">Inactive</option>
                    } else if (ViewBag.Status == "Inactive") {
                        <option value="Active">Active</option>
                        <option value="Inactive" selected>Inactive</option>
                    } else {
                        <option value="Active">Active</option>
                        <option value="Inactive">Inactive</option>
                    }
                </select>
            </div>
            <div class="filter-actions">
                <button type="submit" class="btn btn-secondary">Search</button>
                <a asp-action="Index" class="btn btn-light">Clear</a>
            </div>
        </form>
    </div>

    <div class="table-card">
        <div class="table-card-header">
            <h2>Activity List</h2>
            <span class="record-count">@Model.Count() record(s)</span>
        </div>

        @if (!Model.Any())
        {
            <div class="empty-state"><p>No activities found.</p></div>
        }
        else
        {
            <div class="table-responsive">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Title</th>
                            <th>Date</th>
                            <th>Location</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var a in Model)
                        {
                            <tr>
                                <td><strong>@a.ActivityTitle</strong></td>
                                <td>@a.ActivityDate.ToString("MMM dd, yyyy")</td>
                                <td>@a.Location</td>
                                <td>
                                    @if (a.IsActive)
                                    { <span class="badge badge-active">Active</span> }
                                    else
                                    { <span class="badge badge-inactive">Inactive</span> }
                                </td>
                                <td>
                                    <div class="action-group">
                                        <a asp-action="Details" asp-route-id="@a.ActivityID"
                                           class="btn btn-sm btn-info">View</a>
                                        @if (isAdmin)
                                        {
                                            <a asp-action="Edit" asp-route-id="@a.ActivityID"
                                               class="btn btn-sm btn-warning">Edit</a>
                                            @if (a.IsActive)
                                            {
                                                <form asp-action="Deactivate" asp-route-id="@a.ActivityID"
                                                      method="post" class="form-inline"
                                                      data-confirm="Cancel this activity?">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-sm btn-danger">Cancel</button>
                                                </form>
                                            }
                                            else
                                            {
                                                <form asp-action="Activate" asp-route-id="@a.ActivityID"
                                                      method="post" class="form-inline">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-sm btn-success">Activate</button>
                                                </form>
                                            }
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        <partial name="_Pager" model="ViewBag.Pager" />
    </div>

</div>
