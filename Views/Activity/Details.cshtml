@model StudentOrganizationSystem.Models.Activity

@{
    ViewData["Title"] = "Activity Details";

    var isAdmin = User.IsInRole(AppRoles.Admin);

    // The status is derived from the date + time + cancel flag (see ActivityStatus).
    var status = ActivityStatus.For(Model);
    var schedule = Model.StartTime.ToString("hh\\:mm") + " – " + Model.EndTime.ToString("hh\\:mm");
}

<div class="form-container">

    <div class="page-header form-head">
        <div class="page-header-text">
            <h1>Activity Details</h1>
            <p>View complete activity information</p>
        </div>
        <a asp-action="Index" class="btn btn-light">← Back</a>
    </div>

    <div class="details-card">

        <div class="details-row">
            <span class="details-label">Title</span>
            <span class="details-value"><strong>@Model.ActivityTitle</strong></span>
        </div>

        <div class="details-row">
            <span class="details-label">Date</span>
            <span class="details-value">@Model.ActivityDate.ToString("MMMM dd, yyyy")</span>
        </div>

        <div class="details-row">
            <span class="details-label">Time</span>
            <span class="details-value">@schedule</span>
        </div>

        <div class="details-row">
            <span class="details-label">Location</span>
            <span class="details-value">@Model.Location</span>
        </div>

        <div class="details-row">
            <span class="details-label">Faculty / Instructor</span>
            <span class="details-value">
                @(string.IsNullOrWhiteSpace(Model.FacultyInCharge) ? "—" : Model.FacultyInCharge)
            </span>
        </div>

        <div class="details-row">
            <span class="details-label">Description</span>
            <span class="details-value">
                @(string.IsNullOrWhiteSpace(Model.Description) ? "—" : Model.Description)
            </span>
        </div>

        <div class="details-row">
            <span class="details-label">Status</span>
            <span class="details-value">
                <span class="badge @ActivityStatus.BadgeClass(status)">@status</span>
            </span>
        </div>

        <div class="details-row">
            <span class="details-label">Created</span>
            <span class="details-value">@Model.CreatedAt.ToString("MMMM dd, yyyy")</span>
        </div>

        @if (Model.UpdatedAt.HasValue)
        {
            <div class="details-row">
                <span class="details-label">Last Updated</span>
                <span class="details-value">@Model.UpdatedAt.Value.ToString("MMMM dd, yyyy")</span>
            </div>
        }

        <div class="details-actions">
            @if (isAdmin)
            {
                <a asp-action="Edit" asp-route-id="@Model.ActivityID" class="btn btn-primary">Edit</a>
            }
            <a asp-action="Index" class="btn btn-light">Back to Activities</a>
        </div>

    </div>

</div>
