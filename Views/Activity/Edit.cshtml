@model StudentOrganizationSystem.Models.Activity

@{
    ViewData["Title"] = "Edit Activity";
}

<div class="form-container">

    <div class="page-header form-head">
        <div class="page-header-text">
            <h1>Edit Activity</h1>
            <p>Update activity information</p>
        </div>
        <a asp-action="Index" class="btn btn-light">← Back</a>
    </div>

    <div class="form-card">
        <form asp-action="Edit" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="ActivityID" />
            <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

            <div class="form-group">
                <label asp-for="ActivityTitle">Activity Title</label>
                <input asp-for="ActivityTitle" class="form-control" />
                <span asp-validation-for="ActivityTitle" class="validation-message"></span>
            </div>

            <div class="form-group">
                <label asp-for="ActivityDate">Activity Date</label>
                <input asp-for="ActivityDate" type="date" class="form-control" />
                <span asp-validation-for="ActivityDate" class="validation-message"></span>
            </div>

            <div class="form-group">
                <label asp-for="StartTime">Start Time</label>
                <input asp-for="StartTime" type="time" class="form-control" />
                <span asp-validation-for="StartTime" class="validation-message"></span>
            </div>

            <div class="form-group">
                <label asp-for="EndTime">End Time</label>
                <input asp-for="EndTime" type="time" class="form-control" />
                <span asp-validation-for="EndTime" class="validation-message"></span>
            </div>

            <div class="form-group">
                <label asp-for="Location">Location</label>
                <input asp-for="Location" class="form-control" />
                <span asp-validation-for="Location" class="validation-message"></span>
            </div>

            <div class="form-group">
                <label asp-for="FacultyInCharge">
                    Faculty / Instructor in charge <span class="label-hint">(optional)</span>
                </label>
                <input asp-for="FacultyInCharge" class="form-control"
                       placeholder="e.g. Prof. Dela Cruz" />
                <span asp-validation-for="FacultyInCharge" class="validation-message"></span>
            </div>

            <div class="form-group">
                <label asp-for="Description">Description <span class="label-hint">(optional)</span></label>
                <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                <span asp-validation-for="Description" class="validation-message"></span>
            </div>

            <div class="form-group">
                <label asp-for="IsActive">Cancellation</label>
                <select asp-for="IsActive" class="form-control">
                    <option value="true">No — keep scheduled</option>
                    <option value="false">Yes — cancelled</option>
                </select>
                <span class="validation-message validation-hint">
                    The status (Upcoming / Ongoing / Finished) is derived from the date and
                    time; cancelling is the only part set by hand.
                </span>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn btn-primary">Save Changes</button>
                <a asp-action="Index" class="btn btn-light">Cancel</a>
            </div>
        </form>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
