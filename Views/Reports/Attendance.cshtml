@model IEnumerable<StudentOrganizationSystem.Models.ActivityAttendanceReportRow>

@{
    ViewData["Title"] = "Attendance Report";
    var totalPresent = ViewBag.TotalPresent as int? ?? 0;
    var totalAbsent = ViewBag.TotalAbsent as int? ?? 0;
}

<div class="page-container">

    <div class="page-header">
        <div class="page-header-text">
            <h1>Attendance by Activity</h1>
            <p>Present / absent counts and attendance rate per activity</p>
        </div>
        <div class="action-group">
            <button type="button" class="btn btn-secondary" id="print-report">Print</button>
            <a asp-action="Index" class="btn btn-light">← Back</a>
        </div>
    </div>

    <div class="filter-card">
        <form asp-action="Attendance" method="get" class="filter-form">
            <div class="filter-group">
                <label>Activity Title</label>
                <input type="text" name="search" value="@ViewBag.Search"
                       placeholder="Search title..." />
            </div>
            <div class="filter-group">
                <label>Status</label>
                <select name="status">
                    <option value="">All</option>
                    @if (ViewBag.Status == "Active") {
                        <option value="Active" selected>Active</option>
                        <option value="Inactive">Inactive</option>
                    } else if (ViewBag.Status == "Inactive") {
                        <option value="Active">Active</option>
                        <option value="Inactive" selected>Inactive</option>
                    } else {
                        <option value="Active">Active</option>
                        <option value="Inactive">Inactive</option>
                    }
                </select>
            </div>
            <div class="filter-actions">
                <button type="submit" class="btn btn-secondary">Search</button>
                <a asp-action="Attendance" class="btn btn-light">Clear</a>
            </div>
        </form>
    </div>

    <div class="print-title">
        Attendance by Activity — generated @DateTime.Now.ToString("MMMM dd, yyyy hh:mm tt")
    </div>

    <div class="table-card">
        <div class="table-card-header">
            <h2>Per-Activity Summary</h2>
            <span class="record-count">@Model.Count() activity/activities</span>
        </div>

        @if (!Model.Any())
        {
            <div class="empty-state"><p>No activities found.</p></div>
        }
        else
        {
            <div class="table-responsive">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Activity</th>
                            <th>Status</th>
                            <th>Present</th>
                            <th>Absent</th>
                            <th>Total</th>
                            <th>Rate</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in Model)
                        {
                            <tr>
                                <td>@row.ActivityDate.ToString("MMM dd, yyyy")</td>
                                <td><strong>@row.ActivityTitle</strong></td>
                                <td>
                                    @if (row.IsActive)
                                    { <span class="badge badge-active">Active</span> }
                                    else
                                    { <span class="badge badge-inactive">Inactive</span> }
                                </td>
                                <td>@row.Present</td>
                                <td>@row.Absent</td>
                                <td>@row.Total</td>
                                <td>@row.Rate.ToString("0.#")%</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr>
                            <th colspan="3">Totals</th>
                            <th>@totalPresent</th>
                            <th>@totalAbsent</th>
                            <th>@(totalPresent + totalAbsent)</th>
                            <th></th>
                        </tr>
                    </tfoot>
                </table>
            </div>
        }
    </div>

</div>



