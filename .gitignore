# ─────────────────────────────────────────────────────────────
#  Student Organization System — files that must never be committed
#  See AUDIT.md P0.1 / P0.2. Verify with:
#     git ls-files | Select-String '^(bin|obj)/|appsettings'
#  (that command must print nothing)
# ─────────────────────────────────────────────────────────────

# Build output — regenerated by every build, and a copy of
# appsettings.json with the real password ends up inside it.
bin/
obj/

# Machine-specific settings and secrets.
# The real MySQL connection string lives here, never in appsettings.json.
appsettings.Development.json
appsettings.*.local.json
appsettings.*.local
*.local.json

# NuGet / EF Core tooling
project.lock.json
*.nuget.g.props
*.nuget.g.targets

# IDE and editor files
.vs/
.vscode/
.idea/
*.user
*.suo
*.userosscache
*.sln.docstates

# Operating system noise
Thumbs.db
Desktop.ini
.DS_Store

# Logs and temporary scratch files
*.log
*.tmp
_tmp_*
